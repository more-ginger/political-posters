# Template only — no real values here. Copy to .env and fill that in instead.
# .env is gitignored; THIS file is not, by design.
#
# This app READS the data collected by the photo-annotator app: the same
# Supabase project and the same B2 bucket. It never writes to either. Prefer
# credentials scoped to that fact — see the notes on each key below.

# --- Backblaze B2, via its S3-compatible API ---------------------------------
# Same bucket the annotator uploads to. Endpoint and region come from the
# bucket's page in the B2 console; the region is the middle part of the endpoint
# host (e.g. s3.eu-central-003... -> eu-central-003).
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=your-bucket-name
# Create a SEPARATE application key for this app, scoped to this one bucket and
# with readFiles only — not the annotator's key, and not the master key. This
# app only signs downloads, so a key that cannot write is a key that cannot
# damage the collection if this site is ever compromised.
B2_KEY_ID=
B2_APPLICATION_KEY=

# --- Supabase ----------------------------------------------------------------
# Same project as the annotator. Settings > Data API > Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co
# A secret key (sb_secret_...) from Settings > API Keys.
#
# It has to be a secret key rather than a publishable one: `submissions` and
# `analyzed_posters` have row-level security enabled with no policies attached,
# so the publishable key can read nothing at all. The secret key bypasses RLS,
# which is exactly why it is server-only — never expose it to the browser, and
# never import anything from src/lib/server/ into a component.
#
# Create a second secret key for this app rather than reusing the annotator's,
# so a leak here forces one rotation and does not take the collection tool down
# with it.
SUPABASE_SECRET_KEY=
